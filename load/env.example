# Required
BASE_URL=https://api.dzmarket.pro
APP_URL=https://app.dzmarket.pro
ANON_KEY=replace_me

# Optional auth load
TEST_EMAIL=
TEST_PASSWORD=
ENABLE_RECOVERY=0
RECOVERY_EMAIL=
AUTH_TEST_MODE=single
# JSON array for pool mode. Example:
# TEST_USERS_JSON=[{"email":"u1@test.com","password":"pass1"},{"email":"u2@test.com","password":"pass2"}]
TEST_USERS_JSON=
# Optional auth threshold override in ms (default 300)
AUTH_P95_MS=300

# Optional orders load
TEST_BUYER_JWT=
WRITE_ENABLED=0
TEST_PRODUCT_ID=
TEST_OFFER_AMOUNT=1000

# Optional shipment load
TEST_SELLER_JWT=
TEST_ORDER_ID=
TEST_LABEL_URL=
ENABLE_GENERATE_SHIPMENT=0

# Runtime knobs
VUS=50
DURATION=5m
